// Debug-only signing for local ScreenCaptureKit / TCC / Keychain stability.
// Does NOT apply to Release (Release keeps project ad-hoc until product distribution).
//
// Defaults are machine-neutral: nothing here requires a local certificate or a
// Team ID, so CI and other checkouts keep building exactly as before.
// Machines that need a stable signing identity put their settings in the
// gitignored sibling file, included last so it wins:
//   DebugSigning.local.xcconfig
// (copy DebugSigning.local.xcconfig.example and fill in the values)

// Single main executable — no SpotifyLyrics.debug.dylib split for TCC.
ENABLE_DEBUG_DYLIB = NO

// Machine-neutral default: no identity, no team. Without the local file a
// plain Debug build is unsigned, which matches the previous behaviour and
// keeps CI and other machines unaffected.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY =

#include? "DebugSigning.local.xcconfig"
