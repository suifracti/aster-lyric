// Copy to DebugSigning.local.xcconfig (gitignored) and set your Team ID.
//
// Find Team ID:
//   Xcode → Settings → Accounts → select Apple ID → Team → Team ID
// or:
//   security find-identity -v -p codesigning
//
// Personal Team (free) is enough for local Debug ScreenCaptureKit testing.

DEVELOPMENT_TEAM = YOUR_TEAM_ID_HERE

// Optional: stable local signing identity, so Keychain ACLs and TCC grants
// survive rebuilds instead of tracking a per-build ad-hoc cdhash.
// CODE_SIGN_STYLE = Manual
// CODE_SIGN_IDENTITY = Apple Development
